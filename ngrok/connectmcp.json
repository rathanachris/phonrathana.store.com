{
  "on_tcp_connect": [
    {
      "actions": [
        {
          "type": "restrict-ips",
          "config": {
            "enforce": true,
            "allow": [
              "127.0.0.1:4040"
            ],
            "deny": [
              "127.0.0.1:4040/mcp"
            ]
          }
        }
      ]
    }
  ]
}
